# SOPS Secrets Template
# Copy this structure when creating secrets/secrets.yaml with:
#   sops secrets/secrets.yaml
#
# DO NOT put actual secrets in this file - it's unencrypted!

# SSH Private Keys
private_keys:
    github: |
        -----BEGIN OPENSSH PRIVATE KEY-----
        <your GitHub SSH private key here>
        -----END OPENSSH PRIVATE KEY-----
    # Add more keys as needed:
    # gitlab: |
    #     -----BEGIN OPENSSH PRIVATE KEY-----
    #     ...
    #     -----END OPENSSH PRIVATE KEY-----

# API Tokens
tokens:
    # openai: sk-xxxxxxxxxxxxxxxxxxxxxxxx
    # github: ghp_xxxxxxxxxxxxxxxxxxxxxxxx
    # anthropic: sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Service Passwords
passwords:
    # database: supersecretpassword
    # email_app_password: xxxx-xxxx-xxxx-xxxx

# Wireless Networks (if managing via NixOS)
# wifi:
#     home_network: wifi_password_here
#     work_network: work_wifi_password
