/*******************************************************************************
 *  Kanagawa Wave - Rofi Theme
 *
 *  A clean, modern launcher with rounded corners, a prominent search bar,
 *  subtle accent borders, and the Kanagawa Wave colour palette.
 *
 *  Designed for drun / run / window modes with icons enabled.
 *
 *  LAYOUT ONLY. Every colour comes from palette.rasi, which is generated from
 *  lib/kanagawa-wave.nix and shares its role names with waybar's style.css -
 *  item 5 of docs/plans/desktop-design.md. There is no hex below this line.
 *  Relative imports resolve against this file's own directory, so the two
 *  travel together onto a machine without Nix. One rule lives over there
 *  rather than here - element-text's `highlight` - because rofi's grammar
 *  refuses a variable in that position.
 *
 *  There is no loose length below either: radius is 12 for the window and 8
 *  for a row, borders are 2, and every space is a multiple of 8. That scale
 *  is lib/geometry.nix, and the build asserts this file honours it - item 6
 *  of the same plan.
 ******************************************************************************/

@import "palette.rasi"

/* -- Non-colour defaults ---------------------------------------------------- */

* {
    transparent: transparent;

    /* Typography */
    font:       "Hack Nerd Font 13";

    /* Global resets */
    background-color:   @transparent;
    text-color:         @fg-primary;
}

/* ── Window ───────────────────────────────────────────────────────────────── */

window {
    location:           center;
    anchor:             center;
    width:              680px;
    border:             2px;
    border-color:       @border;
    border-radius:      12px;
    background-color:   @bg-backdrop;
    padding:            0px;
    cursor:             "default";
}

/* ── Main Container ───────────────────────────────────────────────────────── */

mainbox {
    spacing:            0px;
    padding:            0px;
    children:           [ inputbar, message, listview, mode-switcher ];
    background-color:   @transparent;
}

/* ── Input Bar ────────────────────────────────────────────────────────────── */

inputbar {
    padding:            16px;
    spacing:            16px;
    children:           [ textbox-prompt, entry ];
    background-color:   @bg-overlay;
    border-radius:      12px 12px 0px 0px;
    border:             0px 0px 2px 0px;
    border-color:       @info;
}

textbox-prompt {
    expand:             false;
    content:            " ";
    text-color:         @info;
    vertical-align:     0.5;
    horizontal-align:   0.5;
    font:               "Hack Nerd Font 16";
    background-color:   @transparent;
}

entry {
    font:               "Hack Nerd Font 14";
    placeholder:        "Search...";
    placeholder-color:  @fg-muted;
    text-color:         @fg-primary;
    cursor:             text;
    vertical-align:     0.5;
    background-color:   @transparent;
}

/* ── Message ──────────────────────────────────────────────────────────────── */

message {
    border:             0px 0px 2px 0px;
    border-color:       @bg-raised;
    background-color:   @bg-surface;
    padding:            8px 16px;
}

textbox {
    text-color:         @fg-secondary;
    background-color:   @transparent;
}

/* ── List View ────────────────────────────────────────────────────────────── */

listview {
    lines:              8;
    columns:            1;
    fixed-height:       true;
    scrollbar:          false;
    cycle:              true;
    dynamic:            true;
    layout:             vertical;
    spacing:            8px;
    padding:            8px;
    background-color:   @bg-surface;
    border:             0px;
}

/* ── Elements (each row) ──────────────────────────────────────────────────── */

element {
    padding:            8px 16px;
    spacing:            16px;
    border-radius:      8px;
    background-color:   @transparent;
    cursor:             pointer;
}

element normal.normal {
    background-color:   @transparent;
    text-color:         @fg-primary;
}

element normal.urgent {
    background-color:   @transparent;
    text-color:         @danger-bright;
}

element normal.active {
    background-color:   @transparent;
    text-color:         @success;
}

element selected.normal {
    background-color:   @bg-hover;
    text-color:         @info;
    border:             0px 0px 0px 2px;
    border-color:       @info;
}

element selected.urgent {
    background-color:   @bg-hover;
    text-color:         @danger-bright;
    border:             0px 0px 0px 2px;
    border-color:       @danger-bright;
}

element selected.active {
    background-color:   @bg-hover;
    text-color:         @success;
    border:             0px 0px 0px 2px;
    border-color:       @success;
}

element alternate.normal {
    background-color:   @transparent;
    text-color:         @fg-primary;
}

element alternate.urgent {
    background-color:   @transparent;
    text-color:         @danger-bright;
}

element alternate.active {
    background-color:   @transparent;
    text-color:         @success;
}

element-icon {
    size:               28px;
    cursor:             inherit;
    vertical-align:     0.5;
    background-color:   @transparent;
}

element-text {
    vertical-align:     0.5;
    horizontal-align:   0.0;
    cursor:             inherit;
    background-color:   @transparent;
    text-color:         inherit;
    /* `highlight` is set in palette.rasi: rofi's grammar wants a literal
     * colour there and rejects both @info and var(info). */
}

/* ── Mode Switcher ────────────────────────────────────────────────────────── */

mode-switcher {
    spacing:            0px;
    border:             2px 0px 0px 0px;
    border-color:       @bg-raised;
    background-color:   @bg-overlay;
    border-radius:      0px 0px 12px 12px;
    padding:            0px;
}

button {
    padding:            8px 16px;
    text-color:         @fg-muted;
    background-color:   @transparent;
    cursor:             pointer;
    border-radius:      0px;
}

button selected {
    text-color:         @info;
    background-color:   @bg-hover;
    border:             2px 0px 0px 0px;
    border-color:       @info;
}

/* vim:ft=css
*/
